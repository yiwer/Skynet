FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN QODER_SKIP_DOWNLOAD=1 npm ci
COPY tsconfig.json vite.config.ts ./
COPY packages ./packages
COPY apps ./apps
RUN npm run build && npm prune --omit=dev

FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
ENV NODE_ENV=production SKYNET_ANALYSIS_CONFIG=/run/analysis/config.json
WORKDIR /app
COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY deploy/install-qodercn-runtime.mjs /opt/install-qodercn-runtime.mjs
RUN node /opt/install-qodercn-runtime.mjs /opt/qodercn \
    && mkdir -p /data/analysis && chown node:node /data/analysis
USER node
CMD ["node", "dist/apps/analysis/worker.js"]
